<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Form">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="50dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical">

        <TextView
            android:id="@+id/BorrowForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Borrowing Form"
            android:textSize="22sp"
            android:textColor="@color/black"
            android:layout_marginLeft="120dp"/>

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="100dp"
            android:layout_marginRight="80dp"
            android:layout_marginTop="8dp"
            android:textStyle="italic"
            android:textSize="12sp"
            android:text="*Fill out the form with necessary details"
            />

        <TextView
            android:id="@+id/Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp"
            android:textColor="@color/black"
            android:text="Name:" />

        <EditText
            android:id="@+id/inputName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp"
            android:hint="ex: Juan Dela Cruz"
            android:textColor="@color/black"
            android:ems="10"
            android:inputType="text" />

        <TextView
            android:id="@+id/StudentNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp"
            android:textColor="@color/black"
            android:text="Student Number:" />

        <EditText
            android:id="@+id/inputStudentNo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp"
            android:textColor="@color/black"
            android:hint="ex: 02000123456"
            android:ems="10"
            android:inputType="number" />

        <TextView
            android:id="@+id/ContactNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp"
            android:textColor="@color/black"
            android:text="Contact Number:" />

        <EditText
            android:id="@+id/inputContactNo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp"
            android:textColor="@color/black"
            android:hint="ex: 09123456789"
            android:ems="10"
            android:inputType="number|phone" />

        <TextView
            android:id="@+id/Selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp"
            android:textColor="@color/black"
            android:text="Selected Book:" />

        <TextView
            android:id="@+id/SelectedBook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp"
            android:textColor="@color/black"
            android:textSize="20dp"
            android:text="Selected Book" />



            <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp">

            <LinearLayout
                android:id="@+id/borrowlayout"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/borrowlbl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Borrowing Date:"
                    android:textColor="@color/black"/>

                <EditText
                    android:id="@+id/inputborrowDate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:ems="10"
                    android:inputType="date" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/returnlbl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Return Date:"
                    android:textColor="@color/black"/>

                <CalendarView
                    android:id="@+id/inputreturnDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

            <Button
                android:id="@+id/confirmBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="150dp"
                android:layout_marginRight="150dp"
                android:backgroundTint="#FFFFFF"
                android:text="Confirm"
                android:textColor="@color/black"
                app:cornerRadius="10dp"
                app:strokeColor="#000000"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>